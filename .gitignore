# Built by the [[build]] command in herdr-plugin.toml at install time, and by
# `go build -o bin/herdr-scratch .` for a linked local checkout. Platform- and
# arch-specific, so it is never committed.
/bin/

# Where goreleaser stages a build: the four archives, the checksums, and the
# rendered cask. Rebuilt from scratch by every `--clean` run.
/dist/

# Per-machine Claude Code settings. The rest of .claude/ is committed — the
# release skill lives there — so without this line a local settings file sits
# untracked inside a tracked directory, one `git add .` from being shared.
/.claude/settings.local.json
