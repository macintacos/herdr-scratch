#!/bin/sh
# Post a desktop notification about the scratch shell, wearing the icon of the
# terminal herdr is running in.
#
# Usage: herdr-scratch-notify <subtitle> [message]
#
# terminal-notifier posts under whatever identity -sender names, which is what
# gives the notification the host terminal's icon and makes a click activate it.
# macOS hands every app its bundle id in __CFBundleIdentifier, and that survives
# down through herdr into the popup, so the icon follows whichever terminal is
# actually attached rather than being pinned to one.
#
# Without -sender the notification arrives under terminal-notifier's own
# identity: a stock icon, and no way to change it.
#
# Optional, and silently a no-op when terminal-notifier is not installed —
# nothing here should ever break a shell prompt.
set -eu

command -v terminal-notifier >/dev/null 2>&1 || exit 0

set -- -title "scratch" -subtitle "${1:-}" -message "${2:-}" -group herdr-scratch

if [ -n "${__CFBundleIdentifier:-}" ]; then
    set -- "$@" -sender "$__CFBundleIdentifier"
fi

# -sender keeps terminal-notifier alive to own the click, so it must never be
# waited on: this is called from a shell prompt hook.
nohup terminal-notifier "$@" >/dev/null 2>&1 &
